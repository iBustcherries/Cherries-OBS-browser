+/* VkCapture owns this backend directly, so audio is emitted on the Game
+ * Capture source rather than on an independent hidden mixer source. */
+void *cherries_game_audio_create(obs_source_t *source)
+{
+	obs_data_t *settings = obs_data_create();
+	obs_data_set_bool(settings, "CherriesGameAudio", true);
+	obs_data_set_string(settings, SETTING_SELECTION_SINGLE, "__cherries_waiting_for_game__");
+	void *capture = pipewire_audio_capture_app_create(settings, source);
+	obs_data_release(settings);
+	return capture;
+}
+void cherries_game_audio_set_pid(void *capture, pid_t pid)
+{
+	obs_data_t *settings = obs_data_create();
+	obs_data_set_bool(settings, "CherriesGameAudio", true);
+	obs_data_set_int(settings, "CherriesGamePid", pid);
+	obs_data_set_string(settings, SETTING_SELECTION_SINGLE, "__cherries_selected_game__");
+	pipewire_audio_capture_app_update(capture, settings);
+	obs_data_release(settings);
+}
+void cherries_game_audio_destroy(void *capture)
+{
+	pipewire_audio_capture_app_destroy(capture);
+}
