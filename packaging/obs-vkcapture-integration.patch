+static void vkcapture_game_audio_target(vkcapture_source_t *ctx, pid_t pid)
+{
+    pthread_mutex_lock(&ctx->audio_mutex);
+    if (ctx->game_audio && ctx->audio_pid != pid) {
+        cherries_game_audio_set_pid(ctx->game_audio, pid);
+        ctx->audio_pid = pid;
+    }
+    pthread_mutex_unlock(&ctx->audio_mutex);
+}
+static void vkcapture_source_hide(void *data)
+{
+    vkcapture_game_audio_target(data, 0);
