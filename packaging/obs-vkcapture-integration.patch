diff --git a/src/vkcapture.c b/src/vkcapture.c
index b974e22..10a9798 100644
--- a/src/vkcapture.c
+++ b/src/vkcapture.c
@@ -1,3 +1,7 @@
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include "CherriesGameSelection.h"
 /*
 OBS Linux Vulkan/OpenGL game capture
 Copyright (C) 2021 David Rosca <nowrep@gmail.com>
@@ -376,8 +380,14 @@ static vkcapture_client_t *find_matching_client(vkcapture_source_t *ctx)
                 break;
             }
         }
-    } else if (server.clients.num) {
-        client = server.clients.array + server.clients.num - 1;
+    } else {
+        for (size_t i = server.clients.num; i > 0; --i) {
+            vkcapture_client_t *candidate = server.clients.array + i - 1;
+            if (cherries_is_game_candidate(candidate->cdata.exe)) {
+                client = candidate;
+                break;
+            }
+        }
     }
     return client;
 }
