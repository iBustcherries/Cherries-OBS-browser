diff --git a/CMakeLists.txt b/CMakeLists.txt
index 81a8309..3f6af3c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -89,7 +89,10 @@ if (BUILD_PLUGIN)
     set_target_properties(linux-vkcapture PROPERTIES PREFIX "")
     target_include_directories(linux-vkcapture PRIVATE $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}>)
 
-    if (COMMAND install_obs_plugin_with_data)
+    if (COMMAND set_target_properties_obs)
+        set_target_properties_obs(linux-vkcapture PROPERTIES FOLDER plugins PREFIX "")
+        install(DIRECTORY data/ DESTINATION "${OBS_DATA_DESTINATION}/obs-modules/core/linux-vkcapture")
+    elseif (COMMAND install_obs_plugin_with_data)
         install_obs_plugin_with_data(linux-vkcapture data)
     else()
         install(TARGETS linux-vkcapture
@@ -140,3 +143,12 @@ install(FILES ${CMAKE_CURRENT_BINARY_DIR}/obs_vkcapture${LAYER_SUFFIX}.json
 install(PROGRAMS ${CMAKE_CURRENT_BINARY_DIR}/obs-gamecapture
     src/obs-vkcapture src/obs-glcapture
     DESTINATION "${CMAKE_INSTALL_FULL_BINDIR}")
+
+# Pinned third-party capture sources retain their own warning policy when
+# embedded in OBS's stricter top-level build; diagnostics remain visible.
+foreach(capture_target linux-vkcapture VkLayer_obs_vkcapture obs_glcapture)
+    if (TARGET ${capture_target})
+        target_compile_options(${capture_target} PRIVATE -Wno-error)
+        set_target_properties(${capture_target} PROPERTIES C_VISIBILITY_PRESET default COMPILE_WARNING_AS_ERROR OFF)
+    endif()
+endforeach()
