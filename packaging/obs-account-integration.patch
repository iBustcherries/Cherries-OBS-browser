+}
+
+void OBSYoutubeActions::SetCombinedPage(QWidget *page)
+{
+	combined = true;
+	ui->tabWidget->insertTab(0, page, "Twitch Stream Info");
+	ui->tabWidget->setTabText(1, "Create New YouTube Stream");
+	ui->tabWidget->setTabText(2, "Select Existing YouTube Stream");
+	auto existingLayout = ui->scrollAreaWidgetContents->layout();
+	broadcastsTable = new QTableWidget(0, 4, ui->scrollAreaWidgetContents);
+	broadcastsTable->setHorizontalHeaderLabels({"Title", "Scheduled time", "Privacy", "Status"});
+	broadcastsTable->setEditTriggers(QAbstractItemView::NoEditTriggers);
+	broadcastsTable->setSelectionBehavior(QAbstractItemView::SelectRows);
+	broadcastsTable->setSelectionMode(QAbstractItemView::SingleSelection);
+	broadcastsTable->horizontalHeader()->setSectionResizeMode(0, QHeaderView::Stretch);
+	broadcastsTable->setMinimumHeight(250);
+	existingLayout->addWidget(broadcastsTable);
+	broadcastDetails = new QLabel("Select a broadcast to use for your stream.", ui->scrollAreaWidgetContents);
+	broadcastDetails->setTextFormat(Qt::PlainText);
+	broadcastDetails->setWordWrap(true);
+	existingLayout->addWidget(broadcastDetails);
+	auto refresh = new QPushButton("Refresh", ui->scrollAreaWidgetContents);
+	existingLayout->addWidget(refresh);
+	connect(refresh, &QPushButton::clicked, this, [this]() {
+		if (workerThread->isRunning()) {
+			return;
+		}
+		broadcastsTable->setRowCount(0);
+		selectedBroadcast.clear();
+		broadcastDetails->setText("Loading broadcasts…");
+		workerThread->reset();
+		workerThread->start();
+		UpdateOkButtonStatus();
+	});
+	connect(broadcastsTable, &QTableWidget::itemSelectionChanged, this, [this]() {
+		int row = broadcastsTable->currentRow();
+		if (row < 0 || !broadcastsTable->item(row, 0)) {
+			return;
+		}
+		auto item = broadcastsTable->item(row, 0);
+		selectedBroadcast = item->data(Qt::UserRole).toString();
+		autostart = item->data(Qt::UserRole + 1).toBool();
+		autostop = item->data(Qt::UserRole + 2).toBool();
+		broadcastDetails->setText("Selected broadcast: " + item->text() +
+					  "\nScheduled: " + broadcastsTable->item(row, 1)->text() +
+					  "\nPrivacy: " + broadcastsTable->item(row, 2)->text());
+		UpdateOkButtonStatus();
+	});
+	ui->cancelButton->setText("Close");
+	ui->tabWidget->setCurrentIndex(0);
+	UpdateOkButtonStatus();
+}
